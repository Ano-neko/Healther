#!/usr/bin/env bash
# Healther pre-commit: block secrets and personal data from entering the repo.
# Enable once per clone:  git config core.hooksPath .githooks
set -euo pipefail

fail=0

# 1. gitleaks on staged changes (if installed)
if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --staged --no-banner --redact -v >/dev/null 2>&1; then
        echo "✗ gitleaks found a possible secret in staged changes:"
        gitleaks git --staged --no-banner --redact -v || true
        fail=1
    fi
else
    echo "! gitleaks not installed — falling back to pattern checks only"
fi

# 2. Pattern checks that also catch provider keys gitleaks may not know
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -n "$staged" ]; then
    if git diff --cached -U0 -- $staged | grep -E '^\+' | grep -En 'sk-[A-Za-z0-9]{20,}|DEEPSEEK_API_KEY *= *[^$ ]{8,}|Bearer [A-Za-z0-9._-]{20,}' >/dev/null; then
        echo "✗ Staged diff contains something that looks like an API key."
        fail=1
    fi
    # 3. Personal data file types
    if echo "$staged" | grep -Ei '\.(heic|healthexport)$|(^|/)dev-data/|(^|/)export\.xml$' >/dev/null; then
        echo "✗ Staged files look like personal data (photos / health exports):"
        echo "$staged" | grep -Ei '\.(heic|healthexport)$|(^|/)dev-data/|(^|/)export\.xml$'
        fail=1
    fi
fi

if [ $fail -ne 0 ]; then
    echo "Commit blocked. If this is a false positive, inspect carefully before using --no-verify."
    exit 1
fi
